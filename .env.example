# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BOT_OWNER_ID=123456789
URL=https://example.com/login

# OCR fallback (optional)
RAPIDAPI_KEY=

# Browser + OCR (leave empty for auto-detect in PATH)
CHROME_BINARY=
CHROMEDRIVER_PATH=
TESSERACT_CMD=tesseract

# Storage
# Optional MongoDB URI. If unset/unavailable, local JSON is used.
MONGO_URI=
LOCAL_DB_PATH=credentials.json
