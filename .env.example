# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BOT_OWNER_ID=123456789
URL=https://example.com/login

# OCR fallback (optional)
RAPIDAPI_KEY=

# Firefox/Gecko (leave empty for auto-detect in PATH)
FIREFOX_BINARY=
GECKODRIVER_PATH=

# Performance (1 = disable heavy graphics to save data)
LOW_BANDWIDTH_MODE=1

# OCR binary
TESSERACT_CMD=tesseract

# Storage
# Optional MongoDB URI. If unset/unavailable, local JSON is used.
MONGO_URI=
LOCAL_DB_PATH=credentials.json
